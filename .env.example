# Copie este arquivo para .env e substitua todos os valores antes de iniciar o Compose.
# Nunca versione o arquivo .env real.

POSTGRES_DB=estetica_db
POSTGRES_USER=estetica_app
POSTGRES_PASSWORD=

# Usado somente para criar ou migrar o primeiro administrador.
# A aplicação não possui credencial administrativa padrão.
# Após o primeiro acesso, troca de senha e MFA, essas três variáveis podem ser removidas.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=

# Identificador IANA do fuso da clínica.
CLINIC_TIME_ZONE=America/Cuiaba

# O backend único aplica migrations antes de iniciar. Desative somente em um
# deploy coordenado com uma ferramenta externa de migrations.
DATABASE_APPLY_MIGRATIONS=true
DATABASE_ALLOW_PRODUCTION_MIGRATIONS=true

# Mantenha false quando houver Cloudflare Tunnel ou qualquer acesso fora do loopback.
# Use true somente para testar login local em http://127.0.0.1.
ALLOW_INSECURE_HTTP_COOKIES=false

# Quotas do volume clínico em bytes: 500 MB por paciente e 20 GB na instalação.
# Ajuste conforme a capacidade do disco e a política de backup.
FILE_STORAGE_MAX_CLIENT_BYTES=524288000
FILE_STORAGE_MAX_INSTALLATION_BYTES=21474836480
# Community é válida para clínicas elegíveis pela licença QuestPDF. Use Professional ou Enterprise se aplicável.
PDF_QUESTPDF_LICENSE=Community

# Diretório físico para fotos, documentos, PDFs e termos. No Windows com Docker
# Desktop, use barras normais. A aplicação continua enxergando /app/storage.
CLINICAL_STORAGE_HOST_PATH=./clinical-storage

# Portas vinculadas apenas ao próprio servidor. O Tunnel deve apontar somente ao frontend.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=32150
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=32151
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=32152

# Origem HTTPS exata permitida caso a API seja acessada fora do proxy same-origin.
# O domínio público e o Tunnel devem apontar para o frontend em 127.0.0.1:32150.
CORS_ALLOWED_ORIGIN=https://clinic.example.invalid
ALLOWED_HOSTS=clinic.example.invalid

# Integração Google Calendar (OAuth 2.0). Crie as credenciais de aplicativo web no
# projeto Google Cloud da administradora e cadastre exatamente a URL de retorno abaixo.
# A autorização será feita pela conta Google da profissional que possui edição da agenda compartilhada.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
